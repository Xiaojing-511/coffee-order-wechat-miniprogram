<!-- 顾客饮品单页面 - 仅查看模式 -->
<view class="page-content-wrapper">
  <view class="container">
    <!-- 欢迎标题 / 店铺信息 -->
    <view class="welcome-header">
      <view class="header-icons">
        <button class="header-share-btn" open-type="share">
          <text class="header-icon">📤</text>
          <text class="header-icon-label">分享</text>
        </button>
        <view class="header-icon-wrap" bindtap="goToMyOrders">
          <text class="header-icon">📋</text>
          <text class="header-icon-label">订单</text>
        </view>
        <view class="header-icon-wrap" bindtap="goToCart">
          <text class="header-icon">🛒</text>
          <text class="cart-badge" wx:if="{{cartCount > 0}}">{{cartCount}}</text>
          <text class="header-icon-label">购物车</text>
        </view>
      </view>
      <text class="welcome-title">{{store.storeName || '欢迎光临'}}</text>
      <view class="open-status {{store.status === 'closed' ? 'closed' : ''}}">{{store.status === 'closed' ? '休息中' : '营业中'}}</view>
      <text class="welcome-subtitle" wx:if="{{store.openTime}}">营业时间 {{store.openTime}}</text>
      <text class="welcome-announcement" wx:if="{{store.announcement}}">{{store.announcement}}</text>
      <view class="store-contact" wx:if="{{store.address || store.phone}}">
        <text class="store-address" wx:if="{{store.address}}">📍 {{store.address}}</text>
        <text class="store-phone" wx:if="{{store.phone}}">📞 {{store.phone}}</text>
      </view>
    </view>

    <!-- 歇业提示 -->
    <view class="store-closed-banner" wx:if="{{store.status === 'closed'}}">
      <text class="closed-icon">⏸️</text>
      <text class="closed-text">店铺休息中，暂不可下单</text>
    </view>

    <!-- 饮品分类导航 -->
    <view class="category-nav" wx:if="{{categories.length > 1}}">
      <scroll-view scroll-x class="category-scroll">
        <view class="category-nav-list">
          <view 
            class="category-nav-item {{currentCategory === 'all' ? 'active' : ''}}"
            bindtap="selectCategory"
            data-category="all"
          >全部</view>
          <view 
            class="category-nav-item {{currentCategory === item.name ? 'active' : ''}}"
            wx:for="{{categories}}"
            wx:for-item="item"
            wx:key="_id"
            bindtap="selectCategory"
            data-category="{{item.name}}"
          >{{item.name}}</view>
        </view>
      </scroll-view>
    </view>

    <!-- 饮品列表 -->
    <view class="menu-section">
      <!-- 按分类展示饮品 -->
      <view class="category-block" wx:if="{{currentCategory === 'all'}}">
        <view 
          class="category-group"
          wx:for="{{categories}}"
          wx:key="_id"
          wx:for-item="category"
        >
          <view class="category-header" wx:if="{{categoryItemsMap[category.name] && categoryItemsMap[category.name].length > 0}}">
            <text class="category-title">{{category.name}}</text>
            <text class="drink-count">{{categoryItemsMap[category.name].length}} 款</text>
          </view>

          <view class="drink-grid" wx:if="{{categoryItemsMap[category.name] && categoryItemsMap[category.name].length > 0}}">
            <view 
              class="drink-card {{item.available === false ? 'soldout' : ''}}"
              wx:for="{{categoryItemsMap[category.name]}}"
              wx:for-item="item"
              wx:key="_id"
              wx:for-index="index"
              bindtap="goToDetail"
              data-item="{{item}}"
            >
              <view class="drink-image-box" wx:if="{{item.imageUrl}}">
                <image 
                  class="drink-image" 
                  src="{{item.imageUrl}}" 
                  mode="aspectFill"
                />
              </view>
              <view class="drink-info">
                <text class="drink-name">{{item.name}}</text>
                <view class="drink-price-line">
                  <text class="drink-price" wx:if="{{item.price}}">{{formatPrice(item.price)}}</text>
                  <text class="drink-soldout" wx:if="{{item.available === false}}">已售罄</text>
                </view>
                <text class="drink-description" wx:if="{{item.description}}">{{item.description}}</text>
              </view>
            </view>
          </view>
        </view>

        <!-- 未分类的饮品 -->
        <view class="category-group" wx:if="{{categoryItemsMap['未分类'] && categoryItemsMap['未分类'].length > 0}}">
          <view class="category-header">
            <text class="category-title">未分类</text>
            <text class="drink-count">{{categoryItemsMap['未分类'].length}} 款</text>
          </view>

          <view class="drink-grid">
            <view 
              class="drink-card {{item.available === false ? 'soldout' : ''}}"
              wx:for="{{categoryItemsMap['未分类']}}"
              wx:for-item="item"
              wx:key="_id"
              wx:for-index="index"
              bindtap="goToDetail"
              data-item="{{item}}"
            >
              <view class="drink-image-box" wx:if="{{item.imageUrl}}">
                <image 
                  class="drink-image" 
                  src="{{item.imageUrl}}" 
                  mode="aspectFill"
                />
              </view>
              <view class="drink-info">
                <text class="drink-name">{{item.name}}</text>
                <view class="drink-price-line">
                  <text class="drink-price" wx:if="{{item.price}}">{{formatPrice(item.price)}}</text>
                  <text class="drink-soldout" wx:if="{{item.available === false}}">已售罄</text>
                </view>
                <text class="drink-description" wx:if="{{item.description}}">{{item.description}}</text>
              </view>
            </view>
          </view>
        </view>
      </view>

      <!-- 单个分类展示 -->
      <view class="drink-grid" wx:if="{{currentCategory !== 'all'}}">
        <view 
          class="drink-card {{item.available === false ? 'soldout' : ''}}"
          wx:for="{{categoryItemsMap[currentCategory] || []}}"
          wx:for-item="item"
          wx:key="_id"
          wx:for-index="index"
          bindtap="goToDetail"
          data-item="{{item}}"
        >
          <view class="drink-image-box" wx:if="{{item.imageUrl}}">
            <image 
              class="drink-image" 
              src="{{item.imageUrl}}" 
              mode="aspectFill"
            />
          </view>
          <view class="drink-info">
            <text class="drink-name">{{item.name}}</text>
            <view class="drink-price-line">
              <text class="drink-price" wx:if="{{item.price}}">{{formatPrice(item.price)}}</text>
              <text class="drink-soldout" wx:if="{{item.available === false}}">已售罄</text>
            </view>
            <text class="drink-description" wx:if="{{item.description}}">{{item.description}}</text>
          </view>
        </view>
      </view>

      <!-- 加载中 -->
      <view class="empty-state" wx:if="{{loading}}">
        <text class="empty-icon">☕</text>
        <text class="empty-text">加载中...</text>
      </view>

      <!-- 空状态 -->
      <view class="empty-state" wx:if="{{!loading && drinkItems.length === 0}}">
        <text class="empty-icon">📦</text>
        <text class="empty-text">暂无饮品</text>
      </view>
    </view>

    <!-- 隐私政策 -->
    <view class="privacy-link">
      <text bindtap="goToPrivacy" class="privacy-text">隐私政策</text>
    </view>
  </view>
</view>
