<view class="page-content-wrapper">
  <view class="container">

    <!-- 用户信息头部 -->
    <view class="profile-head">
      <view class="avatar">☕</view>
      <view class="profile-info">
        <text class="profile-name">微信顾客</text>
        <text class="profile-openid" wx:if="{{maskedOpenid}}">ID {{maskedOpenid}}</text>
      </view>
      <view class="profile-tag">扫码点单</view>
    </view>

    <!-- 订单状态快捷入口 -->
    <view class="status-bar">
      <view class="status-item {{currentStatus === '' ? 'active' : ''}}" bindtap="switchStatus" data-status="">
        <text class="status-num">{{counts.total || 0}}</text>
        <text class="status-label">全部</text>
      </view>
      <view class="status-item {{currentStatus === 'paid' ? 'active' : ''}}" bindtap="switchStatus" data-status="paid">
        <text class="status-num">{{counts.paid || 0}}</text>
        <text class="status-label">待接单</text>
      </view>
      <view class="status-item {{currentStatus === 'accepted' ? 'active' : ''}}" bindtap="switchStatus" data-status="accepted">
        <text class="status-num">{{counts.accepted || 0}}</text>
        <text class="status-label">制作中</text>
      </view>
      <view class="status-item {{currentStatus === 'ready' ? 'active' : ''}}" bindtap="switchStatus" data-status="ready">
        <text class="status-num">{{counts.ready || 0}}</text>
        <text class="status-label">待取餐</text>
      </view>
      <view class="status-item {{currentStatus === 'done' ? 'active' : ''}}" bindtap="switchStatus" data-status="done">
        <text class="status-num">{{counts.done || 0}}</text>
        <text class="status-label">已完成</text>
      </view>
    </view>

    <!-- 订单列表 -->
    <view class="section-title">我的订单</view>

    <view class="order-list" wx:if="{{displayOrders.length > 0}}">
      <view class="order-card" wx:for="{{displayOrders}}" wx:key="_id">
        <!-- 订单头部 -->
        <view class="order-header" bindtap="toggleExpand" data-id="{{item._id}}">
          <view class="order-header-left">
            <text class="order-store-name" wx:if="{{item.storeName}}">{{item.storeName}}</text>
            <text class="order-time">{{formatTime(item.createTime)}}</text>
          </view>
          <view class="order-status {{item.status}}">{{statusText[item.status] || item.status}}</view>
        </view>

        <!-- 商品摘要 -->
        <view class="order-items">
          <view class="order-item-row" wx:for="{{item.items}}" wx:for-item="oi" wx:key="key" wx:for-index="oiIndex">
            <text class="oi-name">{{oi.name}}</text>
            <text class="oi-spec" wx:if="{{oi.temperature || oi.sugarLevel}}">{{oi.temperature}}/{{oi.iceLevel}}/{{oi.sugarLevel}}</text>
            <text class="oi-qty">×{{oi.quantity}}</text>
            <text class="oi-price">{{oi.priceText}}</text>
          </view>
          <!-- 展开详情 -->
          <view class="order-detail" wx:if="{{expandedId === item._id}}">
            <view class="detail-row" wx:if="{{item.pickupCode}}"><text class="detail-label">取餐码</text><text class="detail-value pickup">{{item.pickupCode}}</text></view>
            <view class="detail-row" wx:if="{{item.customerName}}"><text class="detail-label">取餐人</text><text class="detail-value">{{item.customerName}}</text></view>
            <view class="detail-row" wx:if="{{item.customerPhone}}"><text class="detail-label">手机号</text><text class="detail-value">{{item.customerPhone}}</text></view>
            <view class="detail-row" wx:if="{{item.pickupTime}}"><text class="detail-label">取餐时间</text><text class="detail-value">{{item.pickupTime}}</text></view>
            <view class="detail-row" wx:if="{{item.remark}}"><text class="detail-label">备注</text><text class="detail-value">{{item.remark}}</text></view>
            <view class="detail-row"><text class="detail-label">支付方式</text><text class="detail-value">{{item.payMethod === 'mock' ? '模拟支付' : '微信支付'}}</text></view>
          </view>
        </view>

        <!-- 订单底部 -->
        <view class="order-footer">
          <text class="order-total-label">共 {{item.totalQuantity}} 件</text>
          <view class="order-actions">
            <view class="order-action-btn" wx:if="{{item.status === 'pending'}}" catchtap="payNow" data-id="{{item._id}}">去支付</view>
            <view class="order-action-btn danger" wx:if="{{item.status === 'pending' || item.status === 'paid'}}" catchtap="cancelOrder" data-id="{{item._id}}">取消订单</view>
            <view class="order-action-btn primary" wx:if="{{item.status !== 'pending' && item.status !== 'cancelled' && item.status !== 'refunded'}}" catchtap="reorder" data-id="{{item._id}}">再来一单</view>
            <text class="order-amount">{{item.totalAmountText}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 空状态 -->
    <view class="empty-orders" wx:elif="{{!loading}}">
      <text class="empty-icon">☕</text>
      <text class="empty-text">{{currentStatus ? '这个状态下还没有订单' : '还没有订单，去点一杯吧'}}</text>
      <view class="go-shopping-btn" bindtap="goShopping">去点单</view>
    </view>

    <!-- 服务 -->
    <view class="service-list">
      <view class="service-item" bindtap="goStoreHome">
        <text class="service-icon">🏠</text>
        <text class="service-label">关于本店</text>
        <text class="service-arrow">›</text>
      </view>
      <button class="service-item service-contact" open-type="contact">
        <text class="service-icon">💬</text>
        <text class="service-label">联系客服</text>
        <text class="service-arrow">›</text>
      </button>
      <view class="service-item" bindtap="goPrivacy">
        <text class="service-icon">📄</text>
        <text class="service-label">隐私政策</text>
        <text class="service-arrow">›</text>
      </view>
    </view>
  </view>

  <!-- 顾客端底部 Tab -->
  <customer-tabbar active="mine" bind:change="onTabChange" />
</view>
