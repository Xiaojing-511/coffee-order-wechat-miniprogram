.page-content-wrapper {
  min-height: 100vh;
  background: #f5efe6;
}

.container {
  padding: 0;
  padding-bottom: 100px;
}

.welcome-header {
  padding: 24px 16px;
  background: linear-gradient(135deg, #8B4513 0%, #6F4E37 100%);
  color: #fff;
  text-align: center;
}

.welcome-title {
  display: block;
  font-size: 24px;
  font-weight: 600;
  margin-bottom: 8px;
}

.welcome-subtitle {
  display: block;
  font-size: 14px;
  opacity: 0.9;
}

.category-nav {
  background: #fff;
  border-bottom: 1px solid #E0E0E0;
  padding: 12px 0;
}

.category-scroll {
  white-space: nowrap;
}

.category-nav-list {
  display: inline-flex;
  padding: 0 16px;
}

.category-nav-item {
  display: inline-block;
  padding: 8px 16px;
  margin-right: 8px;
  font-size: 14px;
  color: #5D4037;
  background: #f5efe6;
  border-radius: 20px;
  transition: all 0.3s;
}

.category-nav-item:last-child {
  margin-right: 0;
}

.category-nav-item.active {
  background: linear-gradient(135deg, #8B4513 0%, #6F4E37 100%);
  color: #fff;
}

.category-nav-item:active {
  opacity: 0.8;
  transform: scale(0.95);
}

.menu-section {
  padding: 12px;
}

.category-block {
  display: flex;
  flex-direction: column;
}

.category-group {
  margin-bottom: 16px;
}

.category-group:last-child {
  margin-bottom: 0;
}

.category-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8px;
  padding: 8px 12px;
  background: rgba(93, 64, 55, 0.7);
  border-radius: 8px;
}

.category-title {
  font-size: 15px;
  font-weight: 500;
  color: #fff;
}

.drink-count {
  font-size: 12px;
  color: #8D6E63;
  background: #FFF3E0;
  padding: 2px 6px;
  border-radius: 10px;
}

.drink-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 12px;
}

.drink-card {
  background: #fff;
  border-radius: 12px;
  overflow: hidden;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
  border: 0.5px solid #f0f0f0;
  transition: all 0.3s;
  display: flex;
  flex-direction: column;
}

.drink-card:active {
  transform: scale(0.97);
  box-shadow: 0 4px 12px rgba(139, 69, 19, 0.15);
  border-color: #d4c4a8;
}

.drink-image-box {
  width: 100%;
  background: #f5f5f5;
  position: relative;
  overflow: hidden;
  flex: 1;
  min-height: 120px;
}

.drink-image {
  width: 100%;
  height: 100%;
  display: block;
}

.drink-info {
  padding: 8px;
  display: flex;
  flex-direction: column;
  max-height: 60px;
  overflow: hidden;
  flex-shrink: 0;
}

.drink-name {
  font-size: 13px;
  font-weight: 600;
  color: #333;
  line-height: 1.3;
}

.drink-calories {
  font-size: 11px;
  color: #D2691E;
  font-weight: 500;
  margin-top: 4px;
}

.drink-description {
  font-size: 10px;
  color: #666;
  line-height: 1.3;
  margin-top: 4px;
}

.empty-state {
  text-align: center;
  padding: 60px 0;
}

.empty-icon {
  display: block;
  font-size: 48px;
  margin-bottom: 12px;
}

.empty-text {
  font-size: 14px;
  color: #999;
}

.privacy-link {
  font-size: 12px;
  color: #999;
  text-align: center;
  padding: 20px 0;
  margin-top: 20px;
}

.privacy-text {
  padding: 8px 16px;
  border-radius: 4px;
  transition: all 0.3s;
}

.privacy-text:active {
  background: rgba(139, 69, 19, 0.1);
  color: #8B4513;
}
