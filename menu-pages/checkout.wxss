.page-content-wrapper {
  min-height: 100vh;
  background: #f5efe6;
}

.container {
  padding: 12px;
  padding-bottom: 100px;
}

.card-section {
  background: #fff;
  border-radius: 12px;
  padding: 16px;
  margin-bottom: 12px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
}

.section-title {
  font-size: 15px;
  font-weight: 600;
  color: #5D4037;
  margin-bottom: 12px;
}

.order-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8px 0;
  border-bottom: 1px solid #f5f5f5;
}

.order-item:last-child {
  border-bottom: none;
}

.order-item-main {
  flex: 1;
  min-width: 0;
}

.order-item-name {
  font-size: 14px;
  font-weight: 600;
  color: #333;
  display: block;
}

.order-item-spec {
  font-size: 11px;
  color: #999;
  margin-top: 2px;
  display: block;
}

.order-item-right {
  display: flex;
  align-items: center;
  gap: 10px;
}

.order-item-qty {
  font-size: 13px;
  color: #666;
}

.order-item-price {
  font-size: 14px;
  font-weight: 700;
  color: #333;
  min-width: 56px;
  text-align: right;
}

.total-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 12px;
  padding-top: 12px;
  border-top: 1px solid #f0f0f0;
  font-size: 13px;
  color: #666;
}

.total-amount {
  display: flex;
  align-items: baseline;
  gap: 6px;
}

.total-amount-label {
  font-size: 13px;
}

.total-amount-price {
  font-size: 20px;
  font-weight: 700;
  color: #C62828;
}

.form-row {
  display: flex;
  align-items: center;
  padding: 12px 0;
  border-bottom: 1px solid #f5f5f5;
}

.form-row:last-child {
  border-bottom: none;
}

.form-label {
  width: 76px;
  font-size: 14px;
  color: #5D4037;
  font-weight: 500;
}

.form-input {
  flex: 1;
  font-size: 14px;
  color: #333;
}

.picker-value {
  font-size: 14px;
  color: #333;
  padding: 4px 8px;
  background: #f5efe6;
  border-radius: 6px;
}

.remark-row {
  align-items: flex-start;
}

.form-textarea {
  flex: 1;
  font-size: 13px;
  color: #333;
  height: 60px;
  line-height: 1.5;
}

.bottom-space {
  height: 100px;
}

.submit-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 64px;
  background: #fff;
  border-top: 1px solid #EFEBE9;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 16px;
  box-shadow: 0 -2px 12px rgba(0, 0, 0, 0.06);
}

.submit-total {
  display: flex;
  flex-direction: column;
}

.submit-total-price {
  font-size: 22px;
  font-weight: 700;
  color: #C62828;
}

.submit-total-note {
  font-size: 10px;
  color: #999;
}

.submit-btn {
  background: linear-gradient(135deg, #8B4513 0%, #6F4E37 100%);
  color: #fff;
  font-size: 15px;
  font-weight: 600;
  padding: 12px 32px;
  border-radius: 24px;
}

.submit-btn.disabled {
  opacity: 0.6;
}

.submit-btn:active {
  opacity: 0.85;
}

.store-note {
  background: #f5efe6;
  border-radius: 8px;
  padding: 10px 12px;
  margin-bottom: 12px;
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.store-note-name {
  font-size: 13px;
  font-weight: 600;
  color: #5D4037;
}

.store-note-text {
  font-size: 12px;
  color: #8D6E63;
  line-height: 1.5;
}
