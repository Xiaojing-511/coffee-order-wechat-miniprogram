.page-content-wrapper {
  min-height: 100vh;
  background: #f5efe4;
}

.container {
  padding: 0;
  padding-bottom: 24px;
}

/* 返回按钮 */
.back-btn {
  position: fixed;
  top: 100px;
  left: 26px;
  width: 50px;
  height: 50px;
  background: rgba(255, 255, 255, 0.8);
  border-radius: 50%;
  display: flex;

  align-items: center;
  justify-content: center;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.42);
  z-index: 100;
}

.back-icon {
  font-size: 20px;
  color: #5D4037;
}

.image-wrapper {
  width: 100%;
  height: 320px;
  background: #fff;
}

.detail-image {
  width: 100%;
  height: 100%;
}

.image-placeholder {
  width: 100%;
  height: 320px;
  background: linear-gradient(135deg, #f5efe6 0%, #EFEBE9 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.placeholder-icon {
  font-size: 80px;
  margin-bottom: 12px;
}

.placeholder-text {
  font-size: 16px;
  color: #999;
}

.info-section {
  padding: 24px 16px;
  background: #fff;
  border-radius: 0 0 16px 16px;
  box-shadow: 0 2px 12px rgba(0, 0, 0, 0.06);
}

.info-section.has-image {
  /* margin-top: -16px; */
  border-radius: 0 0 16px 16px;
}

.drink-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 12px;
}

.drink-name {
  flex: 1;
  font-size: 24px;
  font-weight: 600;
  color: #333;
  line-height: 1.3;
}

.calories-badge {
  display: flex;
  align-items: center;
  gap: 4px;
  padding: 6px 12px;
  background: linear-gradient(135deg, #FFF3E0 0%, #FFE0B2 100%);
  border-radius: 20px;
  margin-left: 12px;
}

.calories-icon {
  font-size: 16px;
}

.calories-value {
  font-size: 14px;
  font-weight: 600;
  color: #D2691E;
}

.category-tag {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  padding: 6px 12px;
  background: #f5efe4;
  border-radius: 6px;
  margin-bottom: 16px;
}

.tag-icon {
  font-size: 14px;
}

.tag-text {
  font-size: 13px;
  color: #8D6E63;
  font-weight: 500;
}

.description-section {
  margin-top: 16px;
  padding-top: 16px;
  border-top: 1px solid #E0E0E0;
}

.section-label {
  display: block;
  font-size: 14px;
  font-weight: 600;
  color: #5D4037;
  margin-bottom: 8px;
}

.description-text {
  display: block;
  font-size: 14px;
  color: #666;
  line-height: 1.6;
}

.features-section {
  margin: 16px;
  padding: 20px;
  background: #fff;
  border-radius: 12px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
}

.features-title {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 16px;
}

.title-icon {
  font-size: 18px;
}

.title-text {
  font-size: 16px;
  font-weight: 600;
  color: #5D4037;
}

.features-list {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.feature-item {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 12px;
  background: #f5efe4;
  border-radius: 8px;
}

.feature-icon {
  width: 40px;
  height: 40px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  font-size: 20px;
  flex-shrink: 0;
}

.feature-icon.temperature {
  background: linear-gradient(135deg, #FF7043 0%, #FF5722 100%);
}

.feature-icon.ice {
  background: linear-gradient(135deg, #4FC3F7 0%, #29B6F6 100%);
}

.feature-icon.sugar {
  background: linear-gradient(135deg, #FFF176 0%, #FFEE58 100%);
}

.feature-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.feature-name {
  font-size: 14px;
  font-weight: 600;
  color: #333;
}

.feature-options {
  font-size: 12px;
  color: #666;
}

.bottom-notice {
  margin: 16px;
  padding: 16px;
  background: linear-gradient(135deg, #E3F2FD 0%, #BBDEFB 100%);
  border-radius: 12px;
  display: flex;
  align-items: center;
  gap: 8px;
}

.notice-icon {
  font-size: 20px;
}

.notice-text {
  font-size: 13px;
  color: #1976D2;
  line-height: 1.5;
}

/* ===== 售卖版新增 ===== */
.drink-title-col {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.drink-price-row {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-top: 6px;
}

.drink-price-main {
  font-size: 22px;
  font-weight: 700;
  color: #a9782f;
}

.drink-soldout-badge {
  font-size: 12px;
  color: #fff;
  background: #bdbdbd;
  padding: 3px 10px;
  border-radius: 12px;
}

/* ===== 下单版新增样式 ===== */
.option-block {
  margin-bottom: 16px;
}

.option-label {
  font-size: 14px;
  font-weight: 600;
  color: #5D4037;
  margin-bottom: 10px;
}

.option-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
}

.option-chip {
  padding: 8px 18px;
  border-radius: 20px;
  font-size: 13px;
  color: #5D4037;
  background: #f5efe4;
  border: 1px solid #D7CCC8;
  transition: all 0.2s;
}

.option-chip.active {
  background: linear-gradient(135deg, #8B4513 0%, #6F4E37 100%);
  color: #fff;
  border-color: #6F4E37;
}

.quantity-section {
  margin: 16px;
  padding: 16px 20px;
  background: #fff;
  border-radius: 12px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.quantity-label {
  font-size: 15px;
  font-weight: 600;
  color: #5D4037;
}

.quantity-stepper {
  display: flex;
  align-items: center;
  gap: 16px;
}

.stepper-btn {
  width: 32px;
  height: 32px;
  border-radius: 50%;
  background: #f5efe4;
  color: #5D4037;
  font-size: 18px;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1px solid #D7CCC8;
}

.stepper-btn.plus {
  background: linear-gradient(135deg, #8B4513 0%, #6F4E37 100%);
  color: #fff;
  border-color: #6F4E37;
}

.stepper-btn:active {
  opacity: 0.7;
}

.stepper-value {
  font-size: 18px;
  font-weight: 700;
  color: #333;
  min-width: 24px;
  text-align: center;
}

.soldout-notice {
  margin: 16px;
  padding: 20px;
  background: linear-gradient(135deg, #F5F5F5 0%, #EEEEEE 100%);
  border-radius: 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
}

.soldout-notice .notice-text {
  color: #757575;
}

.bottom-space {
  height: 120px;
}

/* 底部购物车栏 */
.cart-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 64px;
  background: #fff;
  border-top: 1px solid #EFEBE9;
  display: flex;
  align-items: center;
  padding: 0 16px;
  box-shadow: 0 -2px 12px rgba(0, 0, 0, 0.06);
  z-index: 100;
}

.cart-icon-wrap {
  position: relative;
  width: 44px;
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cart-icon {
  font-size: 26px;
}

.cart-badge {
  position: absolute;
  top: 0;
  right: 0;
  min-width: 18px;
  height: 18px;
  line-height: 18px;
  text-align: center;
  background: #eb3349;
  color: #fff;
  font-size: 11px;
  border-radius: 9px;
  padding: 0 4px;
}

.cart-total {
  flex: 1;
  margin-left: 8px;
}

.cart-total-price {
  font-size: 20px;
  font-weight: 700;
  color: #a9782f;
}

.add-cart-btn {
  background: #201010;
  color: #f0e0d0;
  font-size: 15px;
  font-weight: 600;
  padding: 12px 28px;
  border-radius: 24px;
}

.add-cart-btn:active {
  opacity: 0.85;
}
