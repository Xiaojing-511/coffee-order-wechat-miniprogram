/* 店铺欢迎页 —— 全屏咖啡背景 + 深咖遮罩 + 焦糖金入口 */
.store-home {
  position: relative;
  width: 100vw;
  height: 100vh;
  overflow: hidden;
  background: #201010;
}

.bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(180deg, rgba(20, 10, 6, 0.55) 0%, rgba(20, 10, 6, 0.28) 40%, rgba(20, 10, 6, 0.78) 100%);
}

/* 顶部操作 */
.top-bar {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  z-index: 10;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: calc(env(safe-area-inset-top) + 10px) 16px 0;
}

.back-btn {
  width: 36px;
  height: 36px;
  border-radius: 50%;
  background: rgba(20, 10, 6, 0.45);
  border: 1px solid rgba(240, 224, 208, 0.35);
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-arrow {
  font-size: 18px;
  color: #f0e0d0;
  line-height: 1;
}

.share-btn {
  margin: 0;
  padding: 0 14px;
  height: 36px;
  line-height: 34px;
  font-size: 12px;
  color: #f0e0d0;
  background: rgba(20, 10, 6, 0.45);
  border: 1px solid rgba(240, 224, 208, 0.35);
  border-radius: 99px;
}

.share-btn::after {
  border: none;
}

/* 主内容 */
.content {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 5;
  padding: 0 32px calc(env(safe-area-inset-bottom) + 48px);
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.eyebrow {
  font-size: 12px;
  letter-spacing: 4px;
  color: #e6c98f;
  font-weight: 600;
}

.store-name {
  margin-top: 14px;
  font-size: 42px;
  font-weight: 700;
  color: #faf6ef;
  letter-spacing: 3px;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  text-shadow: 0 3px 18px rgba(0, 0, 0, 0.45);
}

.open-status {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  margin-top: 14px;
  font-size: 12px;
  color: #d9f2e0;
  background: rgba(46, 125, 50, 0.5);
  border: 1px solid rgba(140, 210, 160, 0.55);
  padding: 4px 14px;
  border-radius: 99px;
  letter-spacing: 1px;
}

.open-status.closed {
  color: #ffdcdc;
  background: rgba(198, 40, 40, 0.5);
  border-color: rgba(255, 150, 150, 0.55);
}

.status-dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: #7fd68f;
}

.open-status.closed .status-dot {
  background: #ff8a8a;
}

.hairline {
  width: 44px;
  height: 2px;
  background: linear-gradient(90deg, transparent, #c99343, transparent);
  margin: 22px 0 18px;
}

.desc {
  font-size: 15px;
  line-height: 1.8;
  color: #f0e0d0;
  max-width: 280px;
  text-shadow: 0 2px 10px rgba(0, 0, 0, 0.5);
}

.open-time {
  margin-top: 12px;
  font-size: 13px;
  color: #e6c98f;
  letter-spacing: 1px;
}

.contact {
  margin-top: 10px;
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 6px 14px;
  font-size: 12px;
  color: #c9b39b;
}

.enter-btn {
  margin-top: 34px;
  width: 220px;
  height: 54px;
  line-height: 54px;
  border-radius: 99px;
  background: linear-gradient(150deg, #d4a95e 0%, #c99343 100%);
  color: #fff;
  font-size: 17px;
  font-weight: 700;
  letter-spacing: 6px;
  text-indent: 6px;
  box-shadow: 0 8px 26px rgba(201, 147, 67, 0.5);
  transition: transform 0.15s, box-shadow 0.15s;
}

.enter-btn:active {
  transform: scale(0.96);
  box-shadow: 0 4px 14px rgba(201, 147, 67, 0.4);
}

.hint {
  margin-top: 14px;
  font-size: 12px;
  color: #c9b39b;
  letter-spacing: 1px;
}
