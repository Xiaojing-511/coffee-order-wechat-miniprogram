<view class="page-content-wrapper">
  <view class="container">
    <!-- 成功图标 -->
    <view class="success-icon">✓</view>
    <view class="success-title">{{merchantMode ? '下单成功' : '支付成功'}}</view>
    <view class="success-subtitle" wx:if="{{order}}">{{merchantMode ? '订单已提交至商家订单列表' : '订单已提交，请凭取餐码取餐'}}</view>

    <!-- 取餐码 -->
    <view class="pickup-card" wx:if="{{order && order.pickupCode}}">
      <text class="pickup-label">取餐码</text>
      <text class="pickup-code">{{order.pickupCode}}</text>
      <text class="pickup-note">到店请出示此码</text>
    </view>

    <!-- 订单信息 -->
    <view class="order-info" wx:if="{{order}}">
      <!-- 商品清单 -->
      <view class="oi-list" wx:if="{{order.items && order.items.length > 0}}">
        <view class="oi-row" wx:for="{{order.items}}" wx:for-item="oi" wx:key="key">
          <view class="oi-main">
            <text class="oi-name">{{oi.name}}</text>
            <text class="oi-spec" wx:if="{{oi.temperature || oi.iceLevel || oi.sugarLevel}}">{{oi.temperature}}/{{oi.iceLevel}}/{{oi.sugarLevel}}</text>
          </view>
          <view class="oi-right">
            <text class="oi-unit">{{formatPrice(oi.price)}} × {{oi.quantity}}</text>
            <text class="oi-price">{{formatPrice(oi.price * oi.quantity)}}</text>
          </view>
        </view>
      </view>
      <view class="info-row">
        <text class="info-label">订单号</text>
        <text class="info-value">{{order.orderNo}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">金额</text>
        <text class="info-value price">{{formatPrice(order.totalAmount)}}</text>
      </view>
      <view class="info-row" wx:if="{{order.pickupTime}}">
        <text class="info-label">取餐时间</text>
        <text class="info-value">{{order.pickupTime}}</text>
      </view>
      <view class="info-row" wx:if="{{order.customerName}}">
        <text class="info-label">取餐人</text>
        <text class="info-value">{{order.customerName}}</text>
      </view>
    </view>

    <!-- 按钮 -->
    <view class="action-buttons">
      <view class="action-btn primary" wx:if="{{merchantMode}}" bindtap="goMerchantHome">返回商家端</view>
      <view class="action-btn primary" wx:else bindtap="goToMyOrders">查看我的订单</view>
      <view class="action-btn" bindtap="goBackToMenu">继续点单</view>
    </view>
  </view>
</view>
