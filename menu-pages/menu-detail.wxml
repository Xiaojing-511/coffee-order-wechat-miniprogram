<!-- 顾客饮品单详情页面 - 可下单版本 -->
<view class="page-content-wrapper">
  <!-- 返回按钮 -->
  <view class="back-btn" bindtap="goBack">
    <text class="back-icon">←</text>
  </view>
  
  <view class="container">
    <!-- 饮品图片 -->
    <view class="image-wrapper" wx:if="{{item.imageUrl}}">
      <image 
        class="detail-image" 
        src="{{item.imageUrl}}" 
        mode="aspectFill"
        bindtap="previewImage"
      />
    </view>
    
    <view class="image-placeholder" wx:else>
      <text class="placeholder-icon">🍵</text>
      <text class="placeholder-text">暂无图片</text>
    </view>

    <!-- 饮品信息 -->
    <view class="info-section {{item.imageUrl ? 'has-image' : ''}}">
      <view class="drink-header">
        <view class="drink-title-col">
          <text class="drink-name">{{item.name}}</text>
          <view class="drink-price-row" wx:if="{{item.price}}">
            <text class="drink-price-main">{{formatPrice(item.price)}}</text>
            <text class="drink-soldout-badge" wx:if="{{item.available === false}}">已售罄</text>
          </view>
        </view>
        <view class="calories-badge" wx:if="{{item.calories}}">
          <text class="calories-value">{{item.calories}} kcal</text>
        </view>
      </view>
      
      <view class="category-tag" wx:if="{{item.category && item.category !== '未分类'}}">
        <text class="tag-icon">📁</text>
        <text class="tag-text">{{item.category}}</text>
      </view>
      
      <view class="description-section" wx:if="{{item.description}}">
        <text class="section-label">饮品介绍</text>
        <text class="description-text">{{item.description}}</text>
      </view>
    </view>

    <!-- 可选定制（可交互） -->
    <view class="features-section" wx:if="{{item.available !== false}}">
      <view class="features-title">
        <text class="title-icon">✨</text>
        <text class="title-text">可选定制</text>
      </view>
      
      <!-- 温度 -->
      <view class="option-block">
        <view class="option-label">🌡️ 温度</view>
        <view class="option-chips">
          <view 
            class="option-chip {{temperature === opt ? 'active' : ''}}"
            wx:for="{{temperatureOptions}}"
            wx:for-item="opt"
            wx:key="*this"
            bindtap="selectTemperature"
            data-value="{{opt}}"
          >{{opt}}</view>
        </view>
      </view>
      
      <!-- 冰度 -->
      <view class="option-block">
        <view class="option-label">❄️ 冰度</view>
        <view class="option-chips">
          <view 
            class="option-chip {{iceLevel === opt ? 'active' : ''}}"
            wx:for="{{iceOptions}}"
            wx:for-item="opt"
            wx:key="*this"
            bindtap="selectIceLevel"
            data-value="{{opt}}"
          >{{opt}}</view>
        </view>
      </view>
      
      <!-- 糖度 -->
      <view class="option-block">
        <view class="option-label">🍬 糖度</view>
        <view class="option-chips">
          <view 
            class="option-chip {{sugarLevel === opt ? 'active' : ''}}"
            wx:for="{{sugarOptions}}"
            wx:for-item="opt"
            wx:key="*this"
            bindtap="selectSugarLevel"
            data-value="{{opt}}"
          >{{opt}}</view>
        </view>
      </view>
    </view>

    <!-- 数量选择（售罄不显示） -->
    <view class="quantity-section" wx:if="{{item.available !== false}}">
      <text class="quantity-label">数量</text>
      <view class="quantity-stepper">
        <view class="stepper-btn" bindtap="decreaseQuantity">−</view>
        <text class="stepper-value">{{quantity}}</text>
        <view class="stepper-btn plus" bindtap="increaseQuantity">＋</view>
      </view>
    </view>

    <!-- 售罄提示 -->
    <view class="soldout-notice" wx:if="{{item.available === false}}">
      <text class="notice-icon">⏸️</text>
      <text class="notice-text">该饮品已售罄，看看其他饮品吧</text>
    </view>

    <!-- 底部占位 -->
    <view class="bottom-space"></view>
  </view>

  <!-- 底部购物车栏 -->
  <view class="cart-bar" wx:if="{{item.available !== false}}">
    <view class="cart-icon-wrap" bindtap="goToCart">
      <text class="cart-icon">🛒</text>
      <text class="cart-badge" wx:if="{{cartCount > 0}}">{{cartCount}}</text>
    </view>
    <view class="cart-total" wx:if="{{cartCount > 0}}" bindtap="goToCart">
      <text class="cart-total-price">{{formatPrice(cartTotal)}}</text>
    </view>
    <view class="add-cart-btn" bindtap="addToCart">加入购物车</view>
  </view>
</view>
