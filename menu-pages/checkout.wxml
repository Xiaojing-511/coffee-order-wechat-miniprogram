<view class="page-content-wrapper">
  <view class="container">

    <!-- 商品清单 -->
    <view class="card-section">
      <view class="section-title">商品清单</view>
      <view class="order-item" wx:for="{{items}}" wx:key="key">
        <view class="order-item-main">
          <text class="order-item-name">{{item.name}}</text>
          <text class="order-item-spec">{{item.temperature}} / {{item.iceLevel}} / {{item.sugarLevel}}</text>
        </view>
        <view class="order-item-right">
          <text class="order-item-qty">×{{item.quantity}}</text>
          <text class="order-item-price">{{formatPrice(item.price * item.quantity)}}</text>
        </view>
      </view>
      <view class="total-row">
        <text>共 {{totalQuantity}} 件</text>
        <view class="total-amount">
          <text class="total-amount-label">合计</text>
          <text class="total-amount-price">{{formatPrice(totalAmount)}}</text>
        </view>
      </view>
    </view>

    <!-- 取餐信息 -->
    <view class="card-section">
      <view class="store-note" wx:if="{{storeName || storeNote}}">
        <text class="store-note-name" wx:if="{{storeName}}">🏪 {{storeName}}</text>
        <text class="store-note-text" wx:if="{{storeNote}}">📌 {{storeNote}}</text>
      </view>
      <view class="section-title">取餐信息</view>
      <view class="form-row">
        <text class="form-label">取餐人</text>
        <input class="form-input" placeholder="请输入姓名" value="{{customerName}}" bindinput="onNameInput" />
      </view>
      <view class="form-row">
        <text class="form-label">手机号</text>
        <input class="form-input" type="number" maxlength="11" placeholder="选填，方便联系" value="{{customerPhone}}" bindinput="onPhoneInput" />
      </view>
      <view class="form-row">
        <text class="form-label">取餐时间</text>
        <picker mode="selector" range="{{pickupTimeOptions}}" bindchange="onPickupTimeChange">
          <view class="picker-value">{{pickupTime}} ▾</view>
        </picker>
      </view>
      <view class="form-row remark-row">
        <text class="form-label">备注</text>
        <textarea class="form-textarea" placeholder="口味偏好、忌口等（选填）" value="{{remark}}" bindinput="onRemarkInput" />
      </view>
    </view>

    <!-- 底部占位 -->
    <view class="bottom-space"></view>
  </view>

  <!-- 提交栏 -->
  <view class="submit-bar">
    <view class="submit-total">
      <text class="submit-total-price">{{formatPrice(totalAmount)}}</text>
      <text class="submit-total-note">模拟支付 · 无需真实扣款</text>
    </view>
    <view class="submit-btn {{submitting ? 'disabled' : ''}}" bindtap="submitOrder">{{submitting ? '提交中...' : '提交订单'}}</view>
  </view>
</view>
