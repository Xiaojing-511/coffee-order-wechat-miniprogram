.page-content-wrapper { min-height: 100vh; background: #f5efe6; }
.container { padding: 12px; padding-bottom: 40px; }

.expired-banner {
  background: #FFEBEE; color: #C62828; border-radius: 8px; padding: 10px 14px;
  display: flex; align-items: center; gap: 6px; font-size: 13px; margin-bottom: 12px;
}

.tabs {
  display: flex; gap: 8px; margin-bottom: 12px; overflow-x: auto;
  -webkit-overflow-scrolling: touch; white-space: nowrap;
}
.tab {
  position: relative; padding: 8px 16px; border-radius: 20px;
  background: #fff; color: #5D4037; font-size: 13px; font-weight: 500;
  border: 1px solid #D7CCC8; flex-shrink: 0;
}
.tab.active { background: linear-gradient(135deg, #8B4513 0%, #6F4E37 100%); color: #fff; border-color: #6F4E37; }
.tab-count {
  position: absolute; top: -6px; right: -6px; min-width: 16px; height: 16px; line-height: 16px;
  text-align: center; background: #eb3349; color: #fff; font-size: 10px; border-radius: 8px; padding: 0 4px;
}

.order-list { display: flex; flex-direction: column; gap: 12px; }
.order-card { background: #fff; border-radius: 12px; padding: 14px; box-shadow: 0 2px 8px rgba(0,0,0,0.05); }
.order-head { display: flex; justify-content: space-between; align-items: center; padding-bottom: 10px; border-bottom: 1px solid #f5f5f5; }
.order-no { font-size: 14px; font-weight: 600; color: #333; display: block; }
.order-time { font-size: 11px; color: #999; }
.order-status { font-size: 12px; font-weight: 600; padding: 3px 10px; border-radius: 10px; }
.order-status.pending { background: #FFF3E0; color: #E65100; }
.order-status.paid { background: #E3F2FD; color: #1565C0; }
.order-status.accepted { background: #F3E5F5; color: #6A1B9A; }
.order-status.ready { background: #E8F5E9; color: #2E7D32; }
.order-status.done { background: #F5F5F5; color: #616161; }
.order-status.cancelled { background: #FFEBEE; color: #C62828; }
.order-status.refunded { background: #FCE4EC; color: #AD1457; }

.order-customer { display: flex; align-items: center; gap: 8px; padding: 8px 0; }
.customer-name { font-size: 13px; font-weight: 600; color: #333; }
.customer-phone { font-size: 12px; color: #666; }
.pickup-code { font-size: 13px; font-weight: 700; color: #5D4037; margin-left: auto; letter-spacing: 1px; }

.order-items { padding: 4px 0 10px; border-top: 1px dashed #f0f0f0; }
.oi-row { display: flex; align-items: baseline; gap: 8px; padding: 3px 0; }
.oi-name { font-size: 13px; color: #333; }
.oi-spec { font-size: 11px; color: #999; flex: 1; }
.oi-qty { font-size: 12px; color: #666; }
.oi-remark { font-size: 12px; color: #8D6E63; padding-top: 4px; }

.order-foot { display: flex; justify-content: space-between; align-items: center; padding-top: 10px; border-top: 1px solid #f5f5f5; }
.amount { color: #C62828; font-weight: 700; font-size: 16px; }
.actions { display: flex; gap: 8px; }
.action-btn {
  font-size: 12px; font-weight: 600; padding: 7px 16px; border-radius: 16px;
  background: #f5efe6; color: #5D4037; border: 1px solid #D7CCC8;
}
.action-btn.primary { background: linear-gradient(135deg, #8B4513 0%, #6F4E37 100%); color: #fff; border: none; }
.action-btn.success { background: linear-gradient(135deg, #2E7D32 0%, #43A047 100%); color: #fff; border: none; }
.action-btn.danger { background: #fff; color: #eb3349; border-color: #F3C1C6; }
.action-btn:active { opacity: 0.85; }

.empty { text-align: center; padding: 80px 0; }
.empty-icon { display: block; font-size: 48px; margin-bottom: 8px; }
.empty-text { font-size: 14px; color: #999; }
.empty-hint { display: block; font-size: 12px; color: #bbb; margin-top: 4px; }

/* 代客下单入口 */
.counter-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: linear-gradient(135deg, #8B4513 0%, #6F4E37 100%);
  border-radius: 12px;
  padding: 12px 14px;
  margin-bottom: 12px;
}

.counter-info {
  display: flex;
  align-items: center;
  gap: 8px;
}

.counter-icon { font-size: 22px; }

.counter-text {
  font-size: 13px;
  color: rgba(255, 255, 255, 0.92);
}

.counter-btn {
  background: #fff;
  color: #8B4513;
  font-size: 13px;
  font-weight: 700;
  padding: 8px 18px;
  border-radius: 18px;
  flex-shrink: 0;
}

.counter-btn:active { opacity: 0.85; }

/* 代客下单标记 */
.source-tag {
  font-size: 10px;
  background: #FFF3E0;
  color: #E65100;
  padding: 1px 5px;
  border-radius: 6px;
  margin-left: 4px;
  vertical-align: 1px;
}
