<view class="page-content-wrapper">
  <view class="container">
    <!-- 商家卡片 -->
    <view class="merchant-card" wx:if="{{merchant}}">
      <view class="merchant-avatar">🏪</view>
      <view class="merchant-info">
        <text class="merchant-name">{{merchant.storeName || '我的店铺'}}</text>
        <text class="merchant-storeid">店铺ID：{{merchant.storeId}}</text>
        <text class="merchant-expire {{valid ? '' : 'expired'}}">{{valid ? '服务有效期至 ' + formatExpire(merchant.expireTime) : '服务已到期，请联系平台续费'}}</text>
      </view>
    </view>

    <!-- 功能列表 -->
    <view class="menu-list">
      <view class="menu-item">
        <text class="menu-icon">🆔</text>
        <view class="menu-col">
          <text class="menu-label">我的 openid（发送给平台方开通店铺）</text>
          <text class="menu-sub">{{openid || '登录后可获取'}}</text>
        </view>
      </view>
      <view class="menu-item" bindtap="goStoreSettings">
        <text class="menu-icon">⚙️</text>
        <text class="menu-label">店铺设置</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="goStoreQr">
        <text class="menu-icon">📱</text>
        <text class="menu-label">店铺码 / 分享</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="goMenu">
        <text class="menu-icon">☕</text>
        <text class="menu-label">顾客饮品单</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="goPrivacy">
        <text class="menu-icon">📄</text>
        <text class="menu-label">隐私政策</text>
        <text class="menu-arrow">›</text>
      </view>
    </view>
  </view>
</view>
