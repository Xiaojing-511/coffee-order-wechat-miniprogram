.page-content-wrapper { min-height: 100vh; background: #f5efe6; }
.container { padding: 16px; }
.merchant-card {
  background: linear-gradient(135deg, #8B4513 0%, #6F4E37 100%);
  border-radius: 16px; padding: 20px; display: flex; align-items: center; gap: 14px; margin-bottom: 16px;
}
.merchant-avatar { font-size: 40px; }
.merchant-info { flex: 1; }
.merchant-name { display: block; font-size: 18px; font-weight: 700; color: #fff; }
.merchant-storeid { display: block; font-size: 12px; color: rgba(255,255,255,0.8); margin-top: 2px; }
.merchant-expire { display: block; font-size: 12px; color: #FFE0B2; margin-top: 4px; }
.merchant-expire.expired { color: #FFCDD2; }
.menu-list { background: #fff; border-radius: 12px; overflow: hidden; }
.menu-item {
  display: flex; align-items: center; gap: 12px; padding: 16px;
  border-bottom: 1px solid #f5f5f5;
}
.menu-item:last-child { border-bottom: none; }
.menu-icon { font-size: 20px; }
.menu-label { flex: 1; font-size: 15px; color: #333; }
.menu-arrow { font-size: 18px; color: #ccc; }
.menu-item:active { background: #faf9f6; }

.menu-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.menu-sub {
  font-size: 11px;
  color: #999;
  word-break: break-all;
}
