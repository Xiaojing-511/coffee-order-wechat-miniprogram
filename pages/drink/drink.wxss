.container {
  padding: 16px;
  padding-bottom: 100px;
  background: #f5efe6;

}

.section {
  margin-bottom: 24px;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12px;
}

.section-title {
  font-size: 18px; /* ✅ 使用 px 确保字体大小一致 */
  font-weight: 600;
  color: #5D4037;
}

.btn {
  padding: 6px 12px;
  border-radius: 6px;
  font-size: 14px; /* ✅ 使用 px 确保字体大小一致 */
  font-weight: 500;
}

.btn-primary {
  background: #8D6E63;
  color: #fff;
}

.btn-small {
  padding: 4px 8px;
  font-size: 13px; /* ✅ 使用 px 确保字体大小一致 */
}

/* 分类列表 */
.category-list {
  display: flex;
  flex-wrap: wrap;
}

.category-item {
  display: flex;
  align-items: center;
  margin-right: 8px;
  margin-bottom: 8px;
  padding: 8px 12px;
  background: #fff;
  border: 1px solid #E0E0E0;
  border-radius: 8px;
}

.category-item:nth-last-child(1) {
  margin-right: 0;
}

.category-name {
  font-size: 14px; /* ✅ 使用 px 确保字体大小一致 */
  color: #333;
  font-weight: 600;

}

.delete-btn {
  font-size: 10px; /* ✅ 使用 px 确保字体大小一致 */
  color: #eb3349;
  padding: 2px 4px;
  cursor: pointer;
  transition: all 0.3s ease;
  border: 1px solid transparent;
}

.delete-btn:active {
  transform: scale(0.8);
  opacity: 0.6;
}

/* 按分类展示 */
.categories-drinks {
  display: flex;
  flex-direction: column;
}

.category-block {
  margin-bottom: 24px;
}

.category-block:last-child {
  margin-bottom: 0;
}

.category-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12px;
  padding: 10px 14px;
  background: rgba( 93, 64, 55, 0.7) ;
  border-radius: 8px;
  border: 1px solid transparent;
}

.category-title {
  font-size: 15px; /* ✅ 使用 px 确保字体大小一致 */
  font-weight: 500;
  color: #fff;
}

.drink-count {
  font-size: 12px; /* ✅ 使用 px 确保字体大小一致 */
  color: #8D6E63;
  background: #FFF3E0;
  padding: 2px 6px;
  border-radius: 10px;
}

/* 饮品网格列表 */
.drink-list-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 2px;
}

.drink-item-grid {
  width: 84px;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 10px 8px;
  background: #fff;
  border-radius: 8px;
  transition: all 0.3s ease;
  box-shadow: 0 1px 4px rgba(0, 0, 0, 0.04);
  border: 0.5px solid #f0f0f0;
  margin-right: 10px;
  margin-bottom: 10px;
}

.drink-item-grid:nth-child(4n) {
  margin-right: 0;
}

.drink-item-grid:active {
  background: #f5efe6;
  transform: scale(0.95);
  box-shadow: 0 2px 6px rgba(139, 69, 19, 0.15);
  border-color: #d4c4a8;
}

.drink-item-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
}

.drink-name-text {
  margin-bottom: 4px;
  font-size: 13px; /* ✅ 使用 px 确保字体大小一致 */
  color: #333;
  font-weight: 600;
  line-height: 1.3;
  text-align: center;
  word-break: break-all;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  max-height: 34px;
}

.drink-calories-text {
  font-size: 11px; /* ✅ 使用 px 确保字体大小一致 */
  color: #D2691E;
  font-weight: 500;
  text-align: center;
}

.drink-item-actions {
  display: flex;
  margin-top: 4px;
  width: 100%;
  justify-content: center;
}

.drink-item-actions .item-action-btn {
  margin-right: 4px;
}

.drink-item-actions .item-action-btn:last-child {
  margin-right: 0;
}

.item-action-btn {
  padding: 3px 8px;
  border-radius: 8px;
  border: 1px solid transparent;
  font-size: 10px; /* ✅ 使用 px 确保字体大小一致 */
  font-weight: 500;
  transition: opacity 0.2s;
}

.item-action-btn.edit {
  background: #e3f2fd;
  color: #1976d2;
}

.item-action-btn.delete {
  background: #ffebee;
  color: #eb3349;
}

.item-action-btn:active {
  opacity: 0.7;
}

/* 饮品列表（原竖向布局，已废弃） */
.drink-list {
  display: flex;
  flex-direction: column;
}

.empty-drinks {
  text-align: center;
  padding: 20px 0;
  color: #999;
}

.empty-drinks .empty-icon {
  font-size: 24px; /* ✅ 使用 px 确保字体大小一致 */
  margin-bottom: 8px;
  display: block;
}

.empty-drinks .empty-text {
  font-size: 12px; /* ✅ 使用 px 确保字体大小一致 */
}

/* 饮品卡片（原竖向布局，已废弃） */
.drink-card {
  background: #fff;
  border-radius: 10px;
  padding: 12px;
  box-shadow: 0 2px 12px rgba(93, 64, 55, 0.08);
  border: 1px solid #EFEBE9;
}

.drink-main {
  display: flex;
  margin-bottom: 8px;
}

.drink-main .drink-image {
  margin-right: 12px;
}

.drink-main .drink-info {
  margin-right: 0;
}

.drink-image {
  width: 80px;
  height: 80px;
  border-radius: 6px;
  overflow: hidden;
  background: #f5f5f5;
}

.drink-image image {
  width: 100%;
  height: 100%;
}

.drink-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.drink-name {
  margin-bottom: 4px;
  font-size: 16px; /* ✅ 使用 px 确保字体大小一致 */
  font-weight: 600;
  color: #333;
}

.drink-calories {
  font-size: 14px; /* ✅ 使用 px 确保字体大小一致 */
  color: #8D6E63;
  font-weight: 500;
}

.drink-category {
  font-size: 12px; /* ✅ 使用 px 确保字体大小一致 */
  color: #8D6E63;
  padding: 2px 6px;
  background: #FFF3E0;
  border-radius: 4px;
  align-self: flex-start;
}

.drink-actions {
  display: flex;
  justify-content: flex-end;
}

.drink-actions .action-btn {
  margin-left: 8px;
}

.drink-actions .action-btn:first-child {
  margin-left: 0;
}

.action-btn {
  padding: 6px 12px;
  border-radius: 6px;
  font-size: 13px; /* ✅ 使用 px 确保字体大小一致 */
}

.action-btn.edit {
  background: #FFF3E0;
  color: #8D6E63;
}

.action-btn.delete {
  background: #FFEBEE;
  color: #C62828;
}

/* 空状态 */
.empty {
  text-align: center;
  padding: 40px 0;
  color: #999;
  font-size: 14px; /* ✅ 使用 px 确保字体大小一致 */
}

/* 弹窗样式 */
.modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
}

.modal-content {
  position: relative;
  width: 320px;
  max-width: 600px;
  background: #fff;
  border-radius: 12px;
  overflow: hidden;
  animation: modalSlideUp 0.3s ease;
}

@keyframes modalSlideUp {
  from {
    transform: translateY(50px);
    opacity: 0;
  }
  to {
    transform: translateY(0);
    opacity: 1;
  }
}

.modal-header {
  padding: 16px;
  text-align: center;
  font-size: 16px; /* ✅ 使用 px 确保字体大小一致 */
  font-weight: 600;
  color: #5D4037;
  border-bottom: 1px solid #EFEBE9;
}

.modal-body {
  padding: 16px;
  display: flex;
  flex-direction: column;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
}

.modal-body .modal-input,
.modal-body .modal-textarea,
.modal-body .picker {
  margin-bottom: 12px;
}

.modal-input {
  width: 100%;
  padding: 10px;
  min-height: 50px;
  border: 1px solid #E0E0E0;
  border-radius: 6px;
  font-size: 14px; /* ✅ 使用 px 确保字体大小一致 */
  box-sizing: border-box;
  background: #faf9f6;
}

.modal-input:focus {
  border-color: #8D6E63;
}

.modal-textarea {
  width: 100%;
  min-height: 80px;
  padding: 10px;
  border: 1px solid #E0E0E0;
  border-radius: 6px;
  font-size: 14px; /* ✅ 使用 px 确保字体大小一致 */
  box-sizing: border-box;
  background: #faf9f6;
}

.modal-textarea:focus {
  border-color: #8D6E63;
}

.picker {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 10px;
  border: 1px solid #E0E0E0;
  border-radius: 6px;
  background: #faf9f6;
}

.picker-label {
  font-size: 14px; /* ✅ 使用 px 确保字体大小一致 */
  color: #8D6E63;
}

.picker-value {
  font-size: 14px; /* ✅ 使用 px 确保字体大小一致 */
  color: #5D4037;
}

.modal-footer {
  display: flex;
  border-top: 1px solid #EFEBE9;
}

.modal-btn {
  flex: 1;
  padding: 16px;
  text-align: center;
  font-size: 15px; /* ✅ 使用 px 确保字体大小一致 */
  border-right: 1px solid #EFEBE9;
  color: #8D6E63;
}

.modal-btn:last-child {
  border-right: none;
}

.modal-btn.confirm {
  color: #8D6E63;
  font-weight: 600;
}

.drink-modal {
  max-height: 85vh;
  display: flex;
  flex-direction: column;
}

/* 图片上传区域 */
.image-upload-section {
  margin-bottom: 12px;
}

.image-upload-label {
  font-size: 14px;
  color: #8D6E63;
  margin-bottom: 8px;
}

.image-upload-area {
  width: 100%;
  height: 120px;
  border: 1px dashed #E0E0E0;
  border-radius: 8px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #faf9f6;
  overflow: hidden;
}

.upload-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #bbb;
}

.upload-icon {
  font-size: 32px;
  line-height: 1;
  margin-bottom: 4px;
}

.upload-text {
  font-size: 12px;
}

.upload-preview {
  width: 100%;
  height: 100%;
  position: relative;
}

.preview-image {
  width: 100%;
  height: 100%;
}

.preview-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  transition: opacity 0.3s;
}

.upload-preview:hover .preview-overlay,
.upload-preview:active .preview-overlay {
  opacity: 1;
}

.preview-tip {
  color: #fff;
  font-size: 12px;
  background: rgba(0, 0, 0, 0.5);
  padding: 4px 12px;
  border-radius: 4px;
}

.remove-image-btn {
  margin-top: 8px;
  text-align: center;
  font-size: 12px;
  color: #eb3349;
  padding: 4px 0;
}



/* 隐私政策 */
.privacy-link {
  font-size: 12px; /* ✅ 使用 px 确保字体大小一致 */
  color: #999;
  text-align: center;
  padding: 10px 0;
  margin-top: 20px;
}

.privacy-text {
  color: #999;
  padding: 5px 10px;
  border-radius: 4px;
  transition: all 0.3s ease;
}

.privacy-text:active {
  background: rgba(139, 69, 19, 0.1);
  color: #8B4513;
}

.link-divider {
  color: #ddd;
  margin: 0 8px;
}

.menu-link-text {
  color: #bbb;
  padding: 5px 10px;
  border-radius: 4px;
  transition: all 0.3s ease;
}

.menu-link-text:active {
  background: rgba(139, 69, 19, 0.1);
  color: #8B4513;
}
