.page-content-wrapper { min-height: 100vh; background: #f5efe6; }
.container { padding: 24px 20px; }
.store-card {
  background: #fff; border-radius: 16px; padding: 28px 20px; text-align: center;
  box-shadow: 0 4px 16px rgba(0,0,0,0.06);
}
.store-name { display: block; font-size: 20px; font-weight: 700; color: #333; }
.store-id { display: block; font-size: 13px; color: #999; margin-top: 6px; }
.qr-placeholder {
  width: 200px; height: 200px; margin: 24px auto;
  border: 2px dashed #D7CCC8; border-radius: 16px;
  display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8px;
}
.qr-icon { font-size: 44px; }
.qr-text { font-size: 12px; color: #999; }
.hint { display: block; font-size: 12px; color: #999; margin-bottom: 16px; }
.share-btn {
  background: linear-gradient(135deg, #8B4513 0%, #6F4E37 100%); color: #fff;
  font-size: 15px; font-weight: 600; border-radius: 24px;
}
.share-btn::after { border: none; }
.preview-btn {
  margin-top: 12px; padding: 12px; border-radius: 24px;
  background: #fff; color: #5D4037; font-size: 14px; font-weight: 600;
  border: 1px solid #D7CCC8;
}
