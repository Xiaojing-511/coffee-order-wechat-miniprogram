/* 日报页面样式 - 精简版,移除热门饮品 */
.container {
  min-height: 100vh;
  background: #fff;
  padding-bottom: 10rpx;
}

/* ========== 今日统计卡片 ========== */
.today-stats-card {
  background: linear-gradient(135deg, rgba( 139, 69, 19, 0.6) 0%, #6F4E37 100%);
  margin: 0.75rpx;
  padding: 2.5rpx 2rpx;
  border-radius: 1.75rpx;
  box-shadow: 0 0.75rpx 2.5rpx rgba(139, 69, 19, 0.35);
  position: relative;
  overflow: hidden;
}

/* 装饰背景 */
.today-stats-card::before {
  content: '';
  position: absolute;
  top: -50%;
  right: -20%;
  width: 18.75rpx;
  height: 18.75rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 50%;
}

.today-stats-card::after {
  content: '';
  position: absolute;
  bottom: -30%;
  left: -10%;
  width: 12.5rpx;
  height: 12.5rpx;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 50%;
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 2rpx;
  padding-bottom: 1.25rpx;
  border-bottom: 0.125rpx solid rgba(255, 255, 255, 0.25);
  position: relative;
  z-index: 1;
}

.card-title {
  font-size: 2.25rpx;
  font-weight: 700;
  color: #fff;
  letter-spacing: 0.125rpx;
}

.card-date {
  font-size: 1.625rpx;
  color: rgba(255, 255, 255, 0.95);
  font-weight: 500;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1.5rpx;
  position: relative;
  z-index: 1;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.75rpx;
}

.stat-value {
  font-size: 3rpx;
  font-weight: 700;
  color: #fff;
  text-shadow: 0 0.125rpx 0.5rpx rgba(0, 0, 0, 0.1);
  line-height: 1;
}

.stat-label {
  font-size: 1.5rpx;
  color: rgba(255, 255, 255, 0.95);
  font-weight: 500;
}

/* ========== 历史日报区块 ========== */
.history-section {
  padding: 1.25rpx 0.75rpx ;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 1.5rpx;
}

.section-title {
  font-size: 2.125rpx;
  font-weight: 700;
  color: #333;
  letter-spacing: 0.0625rpx;
}

.section-count {
  font-size: 1.625rpx;
  color: #999;
  padding: 0.5rpx 1rpx;
  background: #f0f0f0;
  border-radius: 1.25rpx;
}

/* ========== 日报列表 ========== */
.daily-list {
  display: flex;
  flex-direction: column;
  gap: 1rpx;
}

.daily-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 1.75rpx;
  background: #fff;
  border-radius: 1.25rpx;
  box-shadow: 0 0.25rpx 1.25rpx rgba(0, 0, 0, 0.06);
  transition: all 0.3s ease;
}

.daily-item:active {
  transform: scale(0.98);
  box-shadow: 0 0.125rpx 0.75rpx rgba(0, 0, 0, 0.08);
}

.daily-main {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 0.75rpx;
}

.daily-date {
  font-size: 1.875rpx;
  font-weight: 600;
  color: #333;
  letter-spacing: 0.03125rpx;
}

.daily-meta {
  display: flex;
  gap: 1.5rpx;
  align-items: center;
}

.daily-count,
.daily-quantity, .daily-calories {
  font-size: 1.625rpx;
  color: #999;
  padding: 1rpx 0.75rpx 0rpx 0rpx;
  /* background: #f5efe6; */
  border-radius: 0.75rpx;
}

.daily-arrow {
  width: 3rpx;
  height: 3rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ccc;
  font-size: 2.5rpx;
  font-weight: 300;
}

/* ========== 空状态 ========== */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 7.5rpx 0;
  gap: 1.5rpx;
}

.empty-icon {
  width: 10rpx;
  height: 10rpx;
  background: linear-gradient(135deg, #8B451315, #6F4E3715);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 5rpx;
  color: rgba(139, 69, 19, 0.3);
}

.empty-text {
  font-size: 1.75rpx;
  color: #999;
  font-weight: 500;
}

/* ========== 详情弹窗 ========== */
.modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  animation: fadeIn 0.3s ease;
}

@keyframes fadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

.modal-content {
  position: relative;
  width: 100%;
  background: #fff;
  border-radius: 2rpx 2rpx 0 0;
  overflow: visible;
  max-height: 85vh;
  display: flex;
  flex-direction: column;
  animation: slideUp 0.4s cubic-bezier(0.16, 1, 0.3, 1);
}

@keyframes slideUp {
  from {
    transform: translateY(100%);
  }
  to {
    transform: translateY(0);
  }
}

.modal-header {
  padding: 2rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 0.125rpx solid #f0f0f0;
  flex-shrink: 0;
  background: #fff;
  position: sticky;
  top: 0;
  z-index: 10;
}

.modal-title {
  font-size: 2rpx;
  font-weight: 700;
  color: #333;
}

.modal-close {
  width: 4rpx;
  height: 4rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 3rpx;
  color: #999;
  font-weight: 300;
  border-radius: 50%;
  background: #f5efe6;
}

.modal-body {
  padding: 2rpx;
  box-sizing: border-box;
  width: 100%;
}

/* ========== 详情内容 ========== */
.report-summary {
  display: flex;
  flex-direction: column;
  gap: 1rpx;
  margin-bottom: 2rpx;
  padding: 1.5rpx;
  background: linear-gradient(135deg, #f5efe6 0%, #fff 100%);
  border-radius: 1.25rpx;
  border: 0.125rpx solid rgba(139, 115, 85, 0.1);
}

.summary-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.summary-label {
  font-size: 1.625rpx;
  color: #666;
  font-weight: 500;
}

.summary-value {
  font-size: 1.75rpx;
  font-weight: 600;
  color: #333;
}

.summary-value.highlight {
  color: #8B4513;
  font-size: 2rpx;
}

/* ========== 前10名饮品统计 ========== */
.top-drinks-section {
  display: flex;
  flex-direction: column;
  gap: 1.25rpx;
}

.top-drinks-section .section-title {
  font-size: 1.75rpx;
  font-weight: 600;
  color: #666;
  padding-left: 0.75rpx;
  border-left: 0.375rpx solid #8B4513;
}

.top-drinks-list {
  display: flex;
  flex-direction: column;
  gap: 1rpx;
}

.top-drink-item {
  display: flex;
  align-items: center;
  gap: 1.25rpx;
  padding: 1.5rpx;
  background: linear-gradient(135deg, #f5efe6 0%, #fff 100%);
  border-radius: 1.25rpx;
  border: 0.125rpx solid rgba(139, 115, 85, 0.1);
  transition: all 0.3s ease;
}

.rank-badge {
  width: 4rpx;
  height: 4rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #8B4513 0%, #6F4E37 100%);
  color: #fff;
  font-size: 1.75rpx;
  font-weight: 700;
  border-radius: 50%;
  flex-shrink: 0;
  box-shadow: 0 0.25rpx 0.75rpx rgba(139, 69, 19, 0.3);
}

.top-drink-item:nth-child(1) .rank-badge {
  background: linear-gradient(135deg, #FFD700 0%, #FFA500 100%);
  font-size: 2rpx;
}

.top-drink-item:nth-child(2) .rank-badge {
  background: linear-gradient(135deg, #C0C0C0 0%, #A0A0A0 100%);
}

.top-drink-item:nth-child(3) .rank-badge {
  background: linear-gradient(135deg, #CD7F32 0%, #B87333 100%);
}

.drink-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 0.5rpx;
}

.drink-info .drink-name {
  font-size: 1.75rpx;
  font-weight: 600;
  color: #333;
}

.drink-info .drink-stats {
  font-size: 1.5rpx;
  color: #999;
}

.drink-percentage {
  font-size: 2rpx;
  font-weight: 700;
  color: #8B4513;
  flex-shrink: 0;
}

/* ========== 记录列表 ========== */
.records-section {
  display: flex;
  flex-direction: column;
  gap: 1.25rpx;
}

.records-title {
  font-size: 1.75rpx;
  font-weight: 600;
  color: #666;
  padding-left: 0.75rpx;
  border-left: 0.375rpx solid #8B4513;
}

.record-card {
  padding: 1.5rpx;
  border-radius: 1.25rpx;
  border: 0.125rpx solid rgba(139, 115, 85, 0.08);
  margin-bottom: 1.25rpx;
}

.record-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 1.25rpx;
  padding-bottom: 1rpx;
  border-bottom: 0.125rpx solid rgba(139, 115, 85, 0.1);
  /* background: #f5efe6; */

}

.record-number {
  font-size: 1.625rpx;
  font-weight: 600;
  color: #8B4513;
  padding: 0.25rpx 0.75rpx;
  background: rgba(139, 115, 85, 0.1);
  border-radius: 0.75rpx;
}

.record-time {
  font-size: 1.5rpx;
  color: #999;
}

.record-items {
  display: flex;
  flex-direction: column;
  gap: 0.75rpx;
}

.drink-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 1rpx 1.25rpx;
  background: #fff;
  border-radius: 1rpx;
  background: #f5efe6;

}

.drink-item .drink-name {
  font-size: 1.75rpx;
  font-weight: 500;
  color: #333;
}

.drink-spec {
  font-size: 1.5rpx;
  color: #999;
  margin-left: 0.75rpx;
}

.drink-quantity {
  font-size: 2rpx;
  font-weight: 700;
  color: #D2691E;
}

.record-summary {
  margin-top: 1.25rpx;
  padding-top: 1rpx;
  border-top: 0.125rpx solid rgba(139, 115, 85, 0.1);
  text-align: right;
}

.summary-calories {
  font-size: 1.75rpx;
  font-weight: 600;
  color: #D2691E;
}

.summary-count {
  font-size: 1.5rpx;
  color: #999;
  margin-top: 0.5rpx;
}

/* ========== 底部按钮 ========== */
.settle-btn {
  position: fixed;
  bottom: 2.5rpx;
  left: 2rpx;
  right: 2rpx;
  background: linear-gradient(135deg, #A0846C 0%, #8B7355 100%);
  color: #fff;
  padding: 1.75rpx;
  border-radius: 3rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.75rpx;
  box-shadow: 0 0.75rpx 2.5rpx rgba(139, 115, 85, 0.4);
  font-size: 2rpx;
  font-weight: 600;
  letter-spacing: 0.125rpx;
  z-index: 100;
}

.settle-btn:active {
  transform: scale(0.96);
}

.btn-icon {
  font-size: 2.25rpx;
}

.btn-text {
  font-size: 1.875rpx;
  font-weight: 600;
}

/* ========== 滚动优化 ========== */
.modal-scroll {
  flex: 1;
  overflow-y: auto;
  width: 100%;
  box-sizing: border-box;
}
